{
  "name": "@itin-labs/supabase-rls-test",
  "version": "0.1.1",
  "description": "Test Supabase row level security policies in-process, with no Docker: your migrations on in-memory Postgres, queried as each kind of user.",
  "keywords": [
    "supabase",
    "rls",
    "row-level-security",
    "postgres",
    "pglite",
    "testing",
    "policies"
  ],
  "homepage": "https://github.com/ITIN-Labs/supabase-rls-test#readme",
  "bugs": {
    "url": "https://github.com/ITIN-Labs/supabase-rls-test/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITIN-Labs/supabase-rls-test.git"
  },
  "license": "MIT",
  "author": "ITIN Labs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:package": "publint --strict && attw --pack . --profile esm-only && size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm test && npm run build && npm run check:package && npm stage publish"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "expect-type": "^1.4.0",
    "fast-check": "^4.11.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
